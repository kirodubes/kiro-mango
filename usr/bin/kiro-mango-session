#!/bin/sh
#####################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
#####################################################################
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
# Purpose:
#   Session entrypoint for the Kiro mango edition (invoked by
#   kiro-mango.desktop). mango has no in-config autostart mechanism —
#   unlike every other KIROTUX compositor, it needs the startup script
#   passed explicitly via -s.
# Why:
#   .desktop Exec= keys are parsed as a literal argv, not through a
#   shell, so "$HOME" in Exec= is never expanded. A wrapper script is
#   the standard fix (same pattern as ohmychadwm's exec-ohmychadwm and
#   kiro-dwl's kiro-dwl-session).
#####################################################################

exec mango -s "$HOME/.config/mango/autostart.sh"
